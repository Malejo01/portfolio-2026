# Variables de entorno del sitio de la agencia Malejo.
# NUNCA pongas valores reales en este archivo: se commitea. Las claves las
# carga Mauro en Vercel (Settings → Environment Variables).
# Todas son opcionales: sin ninguna, el sitio compila y cae a WhatsApp.
# Las páginas son estáticas: cambiar una variable requiere redeploy.

# ── Sitio ────────────────────────────────────────────────────────────────
# Origen absoluto para canonical, OG y sitemap. En producción: https://malejo.com.ar
NEXT_PUBLIC_SITE_URL=

# ── Contacto ─────────────────────────────────────────────────────────────
# Número para wa.me, internacional y sin "+". Default: 5493875813233
NEXT_PUBLIC_WHATSAPP=
# Link de Cal.com. Vacío = los botones de agenda abren WhatsApp.
NEXT_PUBLIC_CALCOM_URL=

# ── Seña de la demo ──────────────────────────────────────────────────────
# Link de pago de la seña (Mercado Pago u otro). Vacío = alias o WhatsApp.
NEXT_PUBLIC_SENA_URL=
# Monto en pesos, sin puntos. Default: 20000
SENA_MONTO=
# Alias para transferir la seña (opcional).
SENA_ALIAS=

# ── Chat de Malejo (F4) ──────────────────────────────────────────────────
# Clave de la API de Anthropic. Sin ella el chat responde un mensaje fijo
# y ofrece WhatsApp.
ANTHROPIC_API_KEY=
# Modelo del chat. Default: claude-haiku-5-5
MALEJO_MODEL=
# Sal para el hash SHA-256 de las IP y para firmar el consentimiento.
# Generala con: openssl rand -hex 32
MALEJO_SALT=
# Topes de mensajes (tanda R2, seguridad). 0 = sin límite. Vacío = default.
# Ráfaga por IP: mensajes cada 10 minutos. Default 20. Tabla chat_burst.
CHAT_BURST_LIMIT=
# Por IP y por día. Default 150.
CHAT_DAILY_LIMIT_IP=
# Global por día: default 1000, red de seguridad ante abuso del endpoint
# público. Si la base falla, cae a un tope en memoria de 100 (falla cerrado).
# El tope real de gasto es el límite mensual del workspace de Anthropic
# (Console → Limits).
CHAT_DAILY_LIMIT_TOTAL=
# Llave de pruebas: el header "x-malejo-test: <token>" saltea los topes por
# IP (no el global). Mínimo 16 caracteres: openssl rand -hex 24. Exportala
# también al correr npm run eval:chat.
CHAT_TEST_TOKEN=
# Alerta diaria del cron: si ayer el chat superó este número de mensajes,
# avisa por email (Resend) o deja un console.warn. Default 300.
CHAT_ALERT_THRESHOLD=
# Orígenes extra aceptados por /api/chat, /api/contacto y /demo, separados
# por coma (el dominio, NEXT_PUBLIC_SITE_URL y las URLs de Vercel ya están).
# Para probar un build de producción local: http://localhost:3005
CHAT_ALLOWED_ORIGINS=
# Timeout de cada ronda del modelo, en milisegundos. Default: 20000. Si
# vence, el chat cierra con el botón de WhatsApp y la ficha cargada.
CHAT_ROUND_TIMEOUT_MS=

# ── Dólar (R1-F2) ────────────────────────────────────────────────────────
# Tipo de cambio de respaldo, en pesos por dólar, sin puntos (ej.: 1450).
# Se usa solo si dolarapi.com no responde; sin esta variable, el respaldo
# es usd.fallback de docs/agencia/datos/precios.json.
USD_ARS_FALLBACK=

# ── Base de datos (Neon) ─────────────────────────────────────────────────
# Postgres de Neon. Sin ella no se guardan leads ni briefs (el resto anda).
DATABASE_URL=
# Secreto con el que Vercel llama al cron de limpieza (lo genera Vercel).
CRON_SECRET=

# ── Aviso por email de los briefs (F5, opcional) ─────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# ── Anti-spam (opcional) ─────────────────────────────────────────────────
# Cloudflare Turnstile: sin claves no se exige. Con claves se pide en la
# casilla de consentimiento del chat y en el formulario de /demo.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
